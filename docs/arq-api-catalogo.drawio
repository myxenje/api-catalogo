        <mxCell id="c47" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#232F3E;spacing=2;" value="&lt;b&gt;IAM Roles (somente o necessário)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;ecs-task-execution-role&lt;/b&gt;&lt;br&gt;• AmazonECSTaskExecutionRolePolicy (pull ECR, logs)&lt;br&gt;• secretsmanager:GetSecretValue só no segredo do DB&lt;br&gt;&lt;b&gt;ecs-task-role&lt;/b&gt; (aplicação)&lt;br&gt;• apenas as ações AWS que a API usa, sem &quot;*&quot;&lt;br&gt;&lt;b&gt;codepipeline-role&lt;/b&gt;&lt;br&gt;• UseConnection (GitHub), S3 get/put no bucket de artefatos&lt;br&gt;• codebuild:StartBuild, ecs:UpdateService + iam:PassRole (roles da task)&lt;br&gt;&lt;b&gt;codebuild-role&lt;/b&gt;&lt;br&gt;• ecr push só no repositório; logs no log group; S3 do artefato" vertex="1">
          <mxGeometry height="260" width="445" x="1275" y="825" as="geometry" />
        </mxCell>
        <mxCell id="c48" parent="1" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#232F3E;fillColor=#ffffff;strokeColor=#DD344C;dashed=1;spacing=10;" value="&lt;b&gt;Security Groups (referência entre SGs)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;alb-sg&lt;/b&gt;: in 80 ← 0.0.0.0/0 | out 3000 → ecs-sg&lt;br&gt;• &lt;b&gt;ecs-sg&lt;/b&gt;: in 3000 ← alb-sg | out 5432 → rds-sg e 443 → 0.0.0.0/0&lt;br&gt;• &lt;b&gt;rds-sg&lt;/b&gt;: in 5432 ← ecs-sg | sem outbound&lt;br&gt;• Sem SSH aberto; RDS sem acesso público" vertex="1">
          <mxGeometry height="170" width="490" x="1225" y="1105" as="geometry" />
        </mxCell>
        <mxCell id="c49" edge="1" parent="1" source="c4" style="html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#232F3E;edgeStyle=orthogonalEdgeStyle;startArrow=block;startFill=1;" target="c15" value="HTTP/HTTPS">
